# Local authenticated beta settings. Copy to .env.beta.local; never commit secrets.
BETA_PORT=3002
BETA_RESET_URL=https://YOUR-API-TUNNEL/reset
BETA_SMTP_HOST=
BETA_SMTP_PORT=587
BETA_SMTP_SECURE=false
BETA_SMTP_USER=
BETA_SMTP_PASSWORD=
BETA_MAIL_FROM=
# Optional browser origins, comma separated. Native apps do not need a browser Origin.
BETA_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
